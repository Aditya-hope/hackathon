# ==============================================================
# InvoicePilot AI - Environment Configuration
# ==============================================================
# Copy this file to `.env` and fill in real values.
# None of the keys below are required for the app to start, but
# invoice extraction will fail until at least one is set.

# --------------------------------------------------------------
# API Keys
# --------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# --------------------------------------------------------------
# Models
# --------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --------------------------------------------------------------
# Provider Routing
# --------------------------------------------------------------
# Provider used for text documents / provider used for image (vision) documents.
PRIMARY_PROVIDER=gemini
TEXT_PROVIDER=groq
VISION_PROVIDER=gemini

# JSON list of providers to fall back to, in order.
FALLBACK_PROVIDERS=["groq", "nvidia"]

# --------------------------------------------------------------
# Generation Settings
# --------------------------------------------------------------
TEMPERATURE=0.0
MAX_OUTPUT_TOKENS=8192

# --------------------------------------------------------------
# Logging
# --------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --------------------------------------------------------------
# Application
# --------------------------------------------------------------
APP_NAME=InvoicePilot AI
APP_VERSION=1.0.0
# One of: development, staging, production
ENVIRONMENT=development
